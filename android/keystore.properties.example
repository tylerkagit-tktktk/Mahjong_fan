# Copy this file to android/keystore.properties. It is intentionally ignored by Git.
# Keep the release keystore itself outside version control as well.
MYAPP_UPLOAD_STORE_FILE=app/mahjongfan-release-key.keystore
MYAPP_UPLOAD_KEY_ALIAS=replace-with-your-key-alias
MYAPP_UPLOAD_STORE_PASSWORD=replace-with-your-keystore-password
MYAPP_UPLOAD_KEY_PASSWORD=replace-with-your-key-password
